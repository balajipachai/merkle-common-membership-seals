# Copy to .env.local and fill in. Never commit .env.local (it is gitignored).

# Public RPC for Base Sepolia (84532). A public endpoint is fine for local dev.
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Deployed ChaupalSeals contract address (see NOTES-FOR-REVIEW.md for the deploy runbook).
# `npm run dev:local` fills this in automatically for a local anvil deployment.
NEXT_PUBLIC_SEALS_ADDRESS=0x0000000000000000000000000000000000000000

# Comma-separated group ids Chaupal curates into its /groups and /steward directory.
# Group registration itself is permissionless on-chain; this is a display allowlist only.
NEXT_PUBLIC_CHAUPAL_GROUP_IDS=1,2,3

# Basescan API key, used only by `forge script --verify` when deploying (never read by the app).
BASESCAN_API_KEY=

# Base Sepolia RPC used by forge script / forge verify (server-side, not NEXT_PUBLIC_).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
