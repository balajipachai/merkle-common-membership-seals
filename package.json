{
  "name": "merkle-comm-membership-seals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "next build",
    "start": "next start -p 3020",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tree:build": "tsx scripts/build-tree.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "check-secrets": "bash scripts/check-secrets.sh",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test": "npm run check-secrets && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@tanstack/react-query": "^5.102.8",
    "next": "^16.3.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.56.0",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
